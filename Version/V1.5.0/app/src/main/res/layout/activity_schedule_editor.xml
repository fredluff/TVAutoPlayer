<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/settings_horizontal_padding"
        android:paddingTop="@dimen/settings_vertical_padding"
        android:paddingRight="@dimen/settings_horizontal_padding"
        android:paddingBottom="@dimen/settings_vertical_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_editor_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/schedule_editor_description"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/schedule_start_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_background"
            android:text="@string/schedule_start_time"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/schedule_end_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_background"
            android:text="@string/schedule_end_time"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/schedule_overnight_hint"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/schedule_rule_enabled_checkbox"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_background"
            android:buttonTint="@color/primary"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/schedule_rule_enabled_checkbox"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/schedule_playlist_label"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/schedule_selected_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="10"
            android:text="@string/schedule_no_media"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/value_text_size" />

        <Button
            android:id="@+id/select_schedule_media_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_background"
            android:text="@string/select_schedule_media"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/save_schedule_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_background"
            android:text="@string/save_schedule"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/delete_schedule_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_background"
            android:text="@string/delete_schedule"
            android:textColor="@color/danger"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/cancel_schedule_edit_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_background"
            android:text="@string/cancel"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />
    </LinearLayout>

</ScrollView>
