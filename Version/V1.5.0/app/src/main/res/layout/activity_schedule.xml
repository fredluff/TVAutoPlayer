<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/settings_horizontal_padding"
        android:paddingTop="@dimen/settings_vertical_padding"
        android:paddingRight="@dimen/settings_horizontal_padding"
        android:paddingBottom="@dimen/settings_vertical_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/schedule_description"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/schedule_enabled_checkbox"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_background"
            android:buttonTint="@color/primary"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/schedule_master_enabled"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <TextView
            android:id="@+id/schedule_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/schedule_empty"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/schedule_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/add_schedule_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_background"
            android:text="@string/add_schedule"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/clear_all_schedules_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_background"
            android:text="@string/clear_all_schedules"
            android:textColor="@color/danger"
            android:textSize="@dimen/button_text_size" />

        <Button
            android:id="@+id/back_to_settings_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_background"
            android:text="@string/back_to_settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text_size" />
    </LinearLayout>

</ScrollView>
